{
  "name": "abap-package-version-shield",
  "version": "1.6.0",
  "description": "Custom handler for shields.io to display abap package version",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/sbcgua/abap-package-version-shield.git"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config test/vitest.e2e.config.mjs",
    "test:e2e:dev": "env E2E_TARGET=dev vitest run --config test/vitest.e2e.config.mjs",
    "test:e2e:qa": "env E2E_TARGET=qa vitest run --config test/vitest.e2e.config.mjs",
    "lint": "eslint . lib"
  },
  "author": "Alexander Tsybulsky",
  "engines": {
    "node": ">=24"
  },
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2"
  }
}
